# Application
NODE_ENV=development
PORT=3001
# Optional host port used by Docker Compose; the container still listens on PORT.
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database target: local | supabase
DATABASE_TARGET=local

# Local PostgreSQL (used only when DATABASE_TARGET=local)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=manga_marketplace
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=10000

# Supabase PostgreSQL (used only when DATABASE_TARGET=supabase)
# Runtime: direct connection on IPv6, otherwise Supavisor session mode on 5432.
# Migrations: direct connection is preferred. Do not use transaction mode/6543.
# Percent-encode reserved characters in passwords. Do not add sslmode to these URLs.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jgyevingvquztgdcrgjf.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jgyevingvquztgdcrgjf.supabase.co:5432/postgres

# Public CA certificate used for verified TLS in local and Docker execution.
DATABASE_SSL_CA_FILE=src/database/certs/supabase-ca.crt

# Supabase Storage (server-only; never expose the service role key to clients)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Stripe Checkout (server-only; use test keys until launch review is complete)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FRONTEND_URL=http://localhost:3000
# Comma-separated ISO country codes that Checkout may ship to.
STRIPE_ALLOWED_SHIPPING_COUNTRIES=US
# Required in production: active Stripe Shipping Rate IDs reviewed for the
# configured destinations. Development falls back to the fixed test rates.
STRIPE_STANDARD_SHIPPING_RATE_ID=
STRIPE_EXPRESS_SHIPPING_RATE_ID=
STANDARD_SHIPPING_CENTS=499
EXPRESS_SHIPPING_CENTS=999
# Enable only after Stripe Tax has been configured in the Dashboard.
STRIPE_AUTOMATIC_TAX=false
