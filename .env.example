# This is the only environment-file template for the repository.
# Copy it to .env in the repository root. Docker Compose reads that file for
# interpolation and passes it to the application and build-runner services.

# Application
NODE_ENV=production
PORT=3001
API_PORT=3001
FRONTEND_PORT=3000

# Browser -> nginx -> NestJS over the private Compose network.
NEXT_PUBLIC_BACKEND_API_URL=/api
# Public HTTPS origin assigned by the Docker hosting platform. Mirror this
# value into the Netlify dashboard after the Docker application is deployed.
UNIFIED_APP_URL=

# Backend -> frontend. Add every allowed deployed frontend origin, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://manga-marketplace.netlify.app
FRONTEND_URL=https://manga-marketplace.netlify.app

# Database target: local | supabase
DATABASE_TARGET=local

# Local PostgreSQL. DB_HOST=postgres is the Compose service name.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=manga_marketplace
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=10000

# Supabase PostgreSQL. For a persistent backend on an IPv4-only host, use the
# session pooler (port 5432) for DATABASE_URL. Prefer the direct connection for
# migrations. Percent-encode reserved password characters and omit sslmode.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Leave DATABASE_SSL_CA_FILE empty when providing the CA inline instead.
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=src/database/certs/supabase-ca.crt

# Supabase Storage (server-only; never use NEXT_PUBLIC_ for the service key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep false until production underwriting, legal approval, and live-key
# rotation are complete. Live keys also require NODE_ENV=production.
STRIPE_LIVE_MODE_ENABLED=false
# Stripe-hosted seller onboarding returns here. Use HTTPS outside local development.
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/account/payouts?connect=returned
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/account/payouts?connect=refresh
# Integer basis points retained from merchandise only (1000 = 10%). Required in production.
MARKETPLACE_FEE_BPS=
# Code of an active location created in /operations. Leave empty to route new
# orders into the staff assignment queue.
DEFAULT_VERIFICATION_LOCATION_CODE=
STRIPE_ALLOWED_SHIPPING_COUNTRIES=US
STRIPE_STANDARD_SHIPPING_RATE_ID=
STRIPE_EXPRESS_SHIPPING_RATE_ID=
STANDARD_SHIPPING_CENTS=499
EXPRESS_SHIPPING_CENTS=999
STRIPE_AUTOMATIC_TAX=false

# This app redirects to Stripe-hosted Checkout and Stripe-hosted Connect
# onboarding, so it does not require a browser publishable key.
